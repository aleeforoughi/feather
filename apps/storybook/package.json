{
  "name": "@feather-apps/storybook",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --quiet",
    "typecheck": "tsc -p tsconfig.json",
    "test:a11y": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@aleeforoughi/feather-react": "workspace:*",
    "@aleeforoughi/feather-tokens": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "motion": "13.4.6",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
