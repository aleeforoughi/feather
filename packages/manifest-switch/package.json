{
  "name": "@aleeforoughi/feather-manifest-switch",
  "version": "1.11.0",
  "description": "The switch manifestation: scanning and dwell over the web manifestation, so a plan can be operated with one or two switches.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleeforoughi/feather.git",
    "directory": "packages/manifest-switch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aleeforoughi/feather-context": "workspace:^",
    "@aleeforoughi/feather-intent": "workspace:^",
    "@aleeforoughi/feather-liquid": "workspace:^",
    "@aleeforoughi/feather-manifest-web": "workspace:^",
    "@aleeforoughi/feather-react": "workspace:^",
    "@aleeforoughi/feather-tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
