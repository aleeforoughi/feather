{
  "name": "@aleeforoughi/feather-scene",
  "version": "1.22.1",
  "description": "Feather's 3D and WebGL scenes as World renderers: shader backgrounds and image-to-depth on raw WebGL (no dependency), and on Three.js (an optional peer) the object viewer, the studio stage, particles, camera rails and post. Every scene keeps the World's floors: capped pixels, the quality ladder, the capability gate, a poster, pausing when hidden.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleeforoughi/feather.git",
    "directory": "packages/scene"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aleeforoughi/feather-expression": "workspace:^",
    "@aleeforoughi/feather-tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": ">=0.180.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true }
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "three": "0.187.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
