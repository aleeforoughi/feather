{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aleeforoughi/feather/schema/feather.update-1.json",
  "title": "Feather experience update (feather.update/1)",
  "description": "One change to an open experience, applied with applyUpdate() in @aleeforoughi/feather-intent: every op lands, or none does, and the result is valid feather.ir/1. Generated by packages/intent/scripts/generate.ts.",
  "type": "object",
  "required": [
    "update",
    "experience",
    "revision",
    "ops"
  ],
  "additionalProperties": false,
  "properties": {
    "update": {
      "enum": [
        "feather.update/1",
        "feather.update/0"
      ]
    },
    "experience": {
      "$ref": "feather.ir-1.json#/$defs/id"
    },
    "revision": {
      "description": "The experience's revision once applied: one more than before.",
      "type": "integer",
      "minimum": 1
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "node"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "add"
              },
              "node": {
                "$ref": "feather.ir-1.json#/$defs/node"
              },
              "after": {
                "$ref": "feather.ir-1.json#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "node"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "replace"
              },
              "node": {
                "$ref": "feather.ir-1.json#/$defs/node"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "id",
              "set"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "patch"
              },
              "id": {
                "$ref": "feather.ir-1.json#/$defs/id"
              },
              "set": {
                "description": "The fields that change; null removes one. Never id or type.",
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "not": {
                    "enum": [
                      "id",
                      "type"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "remove"
              },
              "id": {
                "$ref": "feather.ir-1.json#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "outcome",
              "summary"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "resolve"
              },
              "outcome": {
                "$ref": "feather.ir-1.json#/$defs/resolution/properties/outcome"
              },
              "summary": {
                "$ref": "feather.ir-1.json#/$defs/resolution/properties/summary"
              },
              "artifact": {
                "$ref": "feather.ir-1.json#/$defs/resolution/properties/artifact"
              }
            }
          }
        ]
      }
    }
  }
}
