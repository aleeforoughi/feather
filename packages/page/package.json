{
  "name": "@aleeforoughi/feather-page",
  "version": "1.22.0",
  "description": "feather.page/0: websites from a schema. The validator, the JSON Schema, the default block library built on feather-expression, the renderer (with the Living Page), and the feather-page CLI.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleeforoughi/feather.git",
    "directory": "packages/page"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./schema/*": "./schema/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "bin",
    "templates",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "node scripts/generate.ts"
  },
  "dependencies": {
    "@aleeforoughi/feather-expression": "workspace:^",
    "@aleeforoughi/feather-living": "workspace:^",
    "@aleeforoughi/feather-react": "workspace:^",
    "@aleeforoughi/feather-scene": "workspace:^",
    "@aleeforoughi/feather-tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "three": "0.187.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "bin": {
    "feather-page": "./bin/feather-page.mjs"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
