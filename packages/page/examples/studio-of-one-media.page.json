    {
      "block": "form",
      "id": "enquiry",
      "variant": "underline",
      "title": "Start a project",
      "body": "Four questions. I answer every message myself, within two days.",
      "action": "/contact",
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "required": true,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "autocomplete": "email"
        },
        {
          "name": "budget",
          "label": "Budget",
          "type": "select",
          "options": [
            "Under €10k",
            "€10k to €30k",
            "Over €30k"
          ],
          "required": true
        },
        {
          "name": "start",
          "label": "When would you like to start?",
          "type": "choice",
          "options": [
            "This month",
            "Next quarter",
            "Just exploring"
          ]
        },
        {
          "name": "message",
          "label": "What are you making?",
          "type": "textarea",
          "required": true,
          "max": 2000,
          "hint": "A sentence or two is enough."
        }
      ],
      "note": "Your answers go only to me, and are deleted when we finish."
    }
