  "sections": [
    {
      "block": "hero",
      "id": "top",
      "variant": "stacked",
      "eyebrow": "Working together",
      "title": "Find the way of working that fits, then book it.",
      "lede": "A short quiz, an honest price, a time that suits you. Everything here works without a sign-up."
    },
    {
      "block": "work",
      "id": "work",
      "title": "Selected work",
      "views": "grid",
      "items": [
        "acceptto",
        "freezon",
        "evercover"
      ]
    },
    {
      "block": "quiz",
      "id": "fit",
      "title": "Which way of working fits you?",
      "body": "Three questions, about a minute. Nothing is sent anywhere.",
      "questions": [
        {
          "id": "stage",
          "q": "Where is the product now?",
          "options": [
            {
              "id": "idea",
              "label": "An idea and a sentence",
              "result": "sprint"
            },
            {
              "id": "live",
              "label": "Live, with people using it",
              "result": "system"
            },
            {
              "id": "growing",
              "label": "Growing faster than the team",
              "result": "embed"
            }
          ]
        },
        {
          "id": "team",
          "q": "Who would I work with?",
          "options": [
            {
              "id": "founder",
              "label": "A founder, mostly",
              "result": "sprint"
            },
            {
              "id": "designers",
              "label": "A few designers and engineers",
              "result": "system"
            },
            {
              "id": "org",
              "label": "Several teams",
              "result": "embed"
            }
          ]
        },
        {
          "id": "time",
          "q": "How soon do you need something real?",
          "help": "Real means something people can use, not a deck.",
          "options": [
            {
              "id": "weeks",
              "label": "In two weeks",
              "result": "sprint"
            },
            {
              "id": "quarter",
              "label": "This quarter",
              "result": "system"
            },
            {
              "id": "ongoing",
              "label": "It never stops",
              "result": "embed"
            }
          ]
        }
      ],
      "results": [
        {
          "id": "sprint",
          "title": "A product sprint",
          "body": "Two weeks, one problem, a prototype people can use at the end.",
          "href": "#cost",
          "label": "See what it costs"
        },
        {
          "id": "system",
          "title": "A design system",
          "body": "Six weeks to tokens, components and the gates that keep them honest.",
          "href": "#cost",
          "label": "See what it costs"
        },
        {
          "id": "embed",
          "title": "Join the team",
          "body": "A few days a week, inside the team, for as long as it helps.",
          "href": "#book",
          "label": "Book a first call"
        }
      ]
    },
    {
      "block": "calculator",
      "id": "cost",
      "title": "What a site costs",
      "body": "Move the pieces; the total follows. It is an estimate, not a quote.",
      "inputs": [
        {
          "id": "pages",
          "label": "Pages",
          "kind": "range",
          "min": 1,
          "max": 20,
          "step": 1,
          "value": 5,
          "unit": "pages"
        },
        {
          "id": "system",
          "label": "Design system",
          "kind": "radio",
          "options": [
            {
              "label": "Use the brand's own",
              "value": 0
            },
            {
              "label": "Make a new one",
              "value": 2400
            }
          ]
        },
        {
          "id": "copy",
          "label": "Copywriting",
          "kind": "toggle",
          "help": "I write every page with you."
        }
      ],
      "lines": [
        {
          "id": "design",
          "label": "Design",
          "formula": "pages * 400 + system"
        },
        {
          "id": "build",
          "label": "Build",
          "formula": "pages * 250"
        },
        {
          "id": "words",
          "label": "Words",
          "formula": "copy * pages * 120"
        }
      ],
      "formula": "round(design + build + words)",
      "prefix": "£",
      "note": "In pounds, before VAT. A real quote follows a first call."
    },
