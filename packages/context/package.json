{
  "name": "@aleeforoughi/feather-context",
  "version": "1.18.0",
  "description": "Who Feather renders for, and where: the persona slice, capability profile and device a host passes per render. Types only; Feather stores none of it.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/aleeforoughi/feather.git", "directory": "packages/context" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
