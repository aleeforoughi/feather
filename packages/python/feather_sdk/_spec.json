            "Recommendation",
            "Alternative",
            "Choice",
            "Action",
            "Approval",
            "IrreversibleAction"
          ]
        },
        "input": {
          "kind": "enum",
          "doc": "The person supplies a value of this kind when choosing it.",
          "values": [
            "Price",
            "Date",
            "Text",
            "Location",
            "Person"
          ]
        }
      }
    },
    {
      "type": "Tradeoff",
      "family": "decision",
      "doc": "What one option gains and costs. At least one gain or cost.",
      "act": false,
      "primaryCapable": false,
      "acts": {},
      "fields": {
        "of": {
          "kind": "ref",
          "doc": "The option the tradeoff describes.",
