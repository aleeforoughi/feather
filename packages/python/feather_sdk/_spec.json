        },
        "label": {
          "kind": "string",
          "doc": "The words for it.",
          "required": true
        },
        "value": {
          "kind": "scalar",
          "doc": "The current value.",
          "required": true
        },
        "options": {
          "kind": "scalars",
          "doc": "The values allowed, when a fixed set.",
          "minItems": 2
        }
      }
