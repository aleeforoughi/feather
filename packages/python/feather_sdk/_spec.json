          "kind": "string",
          "doc": "The question.",
          "required": true
        },
        "original": {
          "kind": "string",
          "doc": "What was understood, in words."
        }
      }
    },
    {
      "type": "Preference",
      "family": "decision",
      "doc": "A setting the person may change. Feather stores nothing; the reply goes back to the caller.",
