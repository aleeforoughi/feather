          "kind": "string",
          "doc": "The predicted option's id in that Choice.",
          "required": true
        },
        "summary": {
          "kind": "string",
          "doc": "Why, in one line."
        },
        "confidence": {
          "kind": "number",
          "doc": "0 to 1.",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "Alternative",
      "family": "decision",
      "doc": "Another way to go than the recommendation.",
      "act": true,
      "primaryCapable": false,
      "acts": {
        "choose": {
          "value": "optional",
          "doc": "Chosen. With an input it carries the value: { amount, currency } for Price, an ISO 8601 string for Date, a string for Text, Location and Person."
