{
  "description": "A caller built for a future IR sends feather.ir/1 to a Feather that reads feather.ir/0.",
  "expect": [
    {
      "code": "unsupported-version",
      "path": "/ir"
    }
  ],
  "ir": {
    "ir": "feather.ir/1",
    "experience": "purchase_approval",
    "nodes": [
      {
        "type": "Text",
        "id": "intro",
        "text": "You have a request to purchase software."
      },
      {
        "type": "Person",
        "id": "req",
        "name": "Finance Manager",
        "role": "approver"
      },
      {
        "type": "Price",
        "id": "cost",
        "amount": 2500,
        "currency": "USD",
        "label": "Annual license"
      },
      {
        "type": "Approval",
        "id": "approve",
        "intent": "review and decide",
        "request": "Approve the purchase of professional software",
        "requester": "req",
        "scope": "Annual software license for the team",
        "primary": true
      }
    ]
  }
}
